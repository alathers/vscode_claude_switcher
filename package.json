{
  "name": "vscode-claude-switcher",
  "displayName": "Claude Switcher - Model Profile Orchestrator",
  "description": "VS Code extension for managing and switching between AI coding-agent model profiles during development sessions",
  "version": "0.1.0",
  "publisher": "claude-switcher",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "claude",
    "ai",
    "llm",
    "model switching",
    "anthropic",
    "openai",
    "ollama"
  ],
  "main": "./out/vscode/extension.js",
  "activationEvents": [
    "onCommand:claudeSwitcher.selectProfile",
    "onCommand:claudeSwitcher.createProfile",
    "onCommand:claudeSwitcher.showActivityLedger",
    "onCommand:claudeSwitcher.showPolicyEditor"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeSwitcher.selectProfile",
        "title": "Claude Switcher: Select Workspace Profile",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.createProfile",
        "title": "Claude Switcher: Create New Profile",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.editProfile",
        "title": "Claude Switcher: Edit Profile",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.validateProfile",
        "title": "Claude Switcher: Validate Profile",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.deleteProfile",
        "title": "Claude Switcher: Delete Profile",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.duplicateProfile",
        "title": "Claude Switcher: Duplicate Profile",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.switchProfile",
        "title": "Claude Switcher: Switch Profile (Handoff)",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.exportHandoffPackage",
        "title": "Claude Switcher: Export Handoff Package",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.deleteHandoffMetadata",
        "title": "Claude Switcher: Delete Handoff Metadata",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.setPrivacyMode",
        "title": "Claude Switcher: Set Privacy Mode",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.approveCloudRequest",
        "title": "Claude Switcher: Approve Cloud Request",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.denyCloudRequest",
        "title": "Claude Switcher: Deny Cloud Request",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.showPolicyEditor",
        "title": "Claude Switcher: Show Policy Editor",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.runDiagnostics",
        "title": "Claude Switcher: Run Diagnostics",
        "category": "Claude Switcher"
      },
      {
        "command": "claudeSwitcher.showActivityLedger",
        "title": "Claude Switcher: Show Activity Ledger",
        "category": "Claude Switcher"
      }
    ],
    "configuration": {
      "title": "Claude Switcher",
      "properties": {
        "claudeSwitcher.defaultProfileId": {
          "type": "string",
          "default": "",
          "description": "Default profile ID for the workspace"
        },
        "claudeSwitcher.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "error",
            "warn",
            "info",
            "debug"
          ],
          "description": "Log level for extension output"
        },
        "claudeSwitcher.routing.priority": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["subscription", "api-credits", "ollama"]
          },
          "default": ["subscription", "api-credits", "ollama"],
          "description": "Ordered list of model sources to route requests. First non-exhausted source is used."
        },
        "claudeSwitcher.routing.taskMappings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["subscription", "api-credits", "ollama", "auto"]
          },
          "default": {},
          "description": "Map task types to specific model sources. Use 'auto' to let Harvey router decide automatically. Example: {\"code-review\": \"ollama\", \"test-generation\": \"ollama\", \"complex-analysis\": \"subscription\"}"
        },
        "claudeSwitcher.routing.autoFallback": {
          "type": "boolean",
          "default": true,
          "description": "If true, automatically fallback to local Ollama when both subscription and API credits are exhausted."
        },
        "claudeSwitcher.routing.thresholds.subscriptionAlertPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 80,
          "description": "Notification threshold: notify when subscription quota usage reaches this percentage (0-100)."
        },
        "claudeSwitcher.routing.thresholds.subscriptionFallbackPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 100,
          "description": "Automatic fallback threshold: switch to API credits when subscription quota usage reaches this percentage (0-100)."
        },
        "claudeSwitcher.routing.harvey.baseUrl": {
          "type": "string",
          "format": "uri",
          "default": "http://localhost:11434",
          "description": "Base URL for Harvey router HTTP service. Required when 'ollama' is in priority list."
        },
        "claudeSwitcher.routing.subscription.plan": {
          "type": "string",
          "enum": ["pro", "max"],
          "default": "pro",
          "description": "Your Claude.ai subscription plan type (Pro or Max). Determines rolling window limits from https://support.claude.com."
        },
        "claudeSwitcher.routing.subscription.dailyLimit": {
          "type": "number",
          "minimum": 1,
          "default": 30,
          "description": "Daily message limit for your plan (from https://support.claude.com). Verify current limits periodically."
        },
        "claudeSwitcher.routing.subscription.rollingWindowDays": {
          "type": "number",
          "minimum": 1,
          "default": 7,
          "description": "Rolling window duration in days (Pro=7 days, Max=14 days per Claude documentation)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^2.0.5",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.9.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
